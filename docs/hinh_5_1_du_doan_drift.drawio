        <mxCell id="n6" value="&lt;b style=&quot;font-size:14px&quot;&gt;DAG loan_propensity_predict&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#444444&quot;&gt;@daily 07:00 · score_date = T · cooldown_days = 7&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="52" width="500" height="56" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b style=&quot;font-size:14px&quot;&gt;① Chốt version @production&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#444444&quot;&gt;đọc alias từng segment, đổi thành số version cố định&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="180" width="500" height="62" as="geometry"/></mxCell>
        <mxCell id="n8" value="&lt;b style=&quot;font-size:14px&quot;&gt;② Đọc đặc trưng ngày T&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#444444&quot;&gt;6 bảng fs_*, report_date = T, ghép theo master_account&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="264" width="500" height="62" as="geometry"/></mxCell>
        <mxCell id="n9" value="&lt;b style=&quot;font-size:14px&quot;&gt;③ Chấm điểm theo segment&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#444444&quot;&gt;mỗi segment dùng model của mình, lấy xác suất lớp dương&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="348" width="500" height="62" as="geometry"/></mxCell>
        <mxCell id="n10" value="&lt;b style=&quot;font-size:14px&quot;&gt;④ Ghi bảng điểm&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#444444&quot;&gt;ghi đè partition score_date = T&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="432" width="500" height="62" as="geometry"/></mxCell>
        <mxCell id="n11" value="&lt;b style=&quot;font-size:14px&quot;&gt;⑤ So 24 đặc trưng với ngày tham chiếu&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#444444&quot;&gt;Evidently · tham chiếu = data_end của version @production&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#444444&quot;&gt;drift ratio = số cột lệch / 24 → none · medium · high · critical&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="566" width="500" height="72" as="geometry"/></mxCell>
        <mxCell id="n12" value="&lt;b style=&quot;font-size:14px&quot;&gt;⑥ Ghi kết quả drift&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#444444&quot;&gt;bảng drift_*, báo cáo HTML, tag driftSeverity&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="660" width="500" height="62" as="geometry"/></mxCell>
        <mxCell id="n13" value="&lt;b style=&quot;font-size:14px&quot;&gt;retrain_check&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#444444&quot;&gt;critical + có nhãn mới hơn data_end&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#444444&quot;&gt;+ đã quá cooldown 7 ngày?&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="800" width="440" height="170" as="geometry"/></mxCell>
        <mxCell id="n14" value="&lt;b style=&quot;font-size:14px&quot;&gt;trigger_retrain&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#444444&quot;&gt;kích hoạt DAG train, as_of = score_date&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="270" height="72" as="geometry"/></mxCell>
